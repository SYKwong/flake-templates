default:
    @just --list

build: test
    mkdir -p build
    clang -Wall -Wextra -g -Iinclude src/*.c -o build/main

run: build
    ./build/main

test target="all":
    ceedling test:{{target}}

clean:
    ceedling clobber
    rm -rf build

update-gems:
    nix shell nixpkgs#ruby nixpkgs#bundler nixpkgs#bundix --command bash -c "bundle lock --update && bundix"
